+/// WebKitGTK's switch for a page painted without OpenGL: with no buffer to hand to the window, it
+/// leaves accelerated compositing off. `WEBKIT_DISABLE_COMPOSITING_MODE` does the same up to 2.52
+/// and keeps OpenGL from 2.54 on.
+#[cfg(target_os = "linux")]
+const NO_GL: &str = "WEBKIT_DISABLE_DMABUF_RENDERER";
+/// Set on the restart `settle` makes: this process already knows it draws on the CPU.
+#[cfg(target_os = "linux")]
+const SETTLED: &str = "STREAMLINE_PLAYER_ON_CPU";
+
+/// Where OpenGL is a CPU rasterizer, restarts the app with WebKitGTK's accelerated compositing
+/// off. Call it first, before Tauri creates a web view.
+///
+/// Composited, WebKitGTK draws the whole window through OpenGL for every frame and reads it back:
+/// on llvmpipe any animation takes about three cores. Without compositing the page is painted by
+/// Skia on the CPU, only where it changed. With a GPU compositing is the cheaper of the two, so
+/// nothing changes there.
+///
+/// WebKitGTK reads the switch when the first web view is created, wry leaves no hook before that,
+/// and the probe starts GTK's and Mesa's threads, after which the environment is no longer safe
+/// to change: the app replaces itself with a copy that starts with the switch set.
+#[cfg(target_os = "linux")]
+pub fn settle() {
+    use std::os::unix::process::CommandExt;
+    let set = |name| std::env::var_os(name).is_some();
+    if set(SETTLED) || set(NO_GL) {
+        return;
+    }
+    if gtk::init().is_err() || !gl::on_cpu() {
+        return;
+    }
+    let Ok(app) = std::env::current_exe() else {
+        return;
+    };
+    let failed = std::process::Command::new(app)
+        .args(std::env::args_os().skip(1))
+        .env(NO_GL, "1")
+        .env(SETTLED, "1")
+        .exec();
+    eprintln!("could not restart without accelerated compositing: {failed}");
+}
+
 /// Read once at startup, on the main thread.
 pub struct OnCpu(pub bool);
 
 pub fn detect() -> OnCpu {
     #[cfg(target_os = "linux")]
-    return OnCpu(gl::on_cpu());
+    return OnCpu(std::env::var_os(SETTLED).is_some() || gl::on_cpu());
     #[cfg(not(target_os = "linux"))]
     OnCpu(false)
 }
